# ============================================
# BharatHack — root .gitignore
# ============================================
# Patterns here apply recursively to every subfolder
# (including UseItUp/ and UseItUp/backend/).


# ============================================
# LARGE BINARY ASSETS  (not for git)
# ============================================

# Frame sequence (192 JPEGs, ~24 MB)
# Served from CloudFront: https://d21m7w28iod98m.cloudfront.net/frames/v1/
# Git is not built for binaries — every commit duplicates the full
# file, bloating the repo permanently. Stored in S3 + CloudFront instead.
frames/

# Raw source clips (~8.8 MB) — the masters frames are exported from
video/

# Any exported/animated assets that should live in S3/CloudFront
*.mp4
*.mov
*.avi
*.webm


# ============================================
# SECRETS / ENVIRONMENT  (never commit)
# ============================================

.env
.env.*
!.env.example

# AI tool config — contains a plaintext API key
opencode.jsonc

# AWS credentials / keys
.aws/
credentials
*.pem
*.key
*.p12


# ============================================
# NODE / VITE
# ============================================

node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ============================================
# PYTHON / AWS SAM  (UseItUp/backend)
# ============================================

__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# SAM build artifacts
.aws-sam/

# Testing / linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/


# ============================================
# IDE / EDITOR
# ============================================

.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*~


# ============================================
# OS FILES
# ============================================

.DS_Store
Thumbs.db
desktop.ini